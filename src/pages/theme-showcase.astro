---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import themes from "../../themes/registry.json" assert { type: "json" };

const workflow = [
  { label: "List registry", command: "npm run theme:list" },
  { label: "Install a template", command: "npm run theme:install -- <id>" },
  { label: "Enable the active template", command: "npm run theme:enable -- <id>" },
  { label: "Run the active theme", command: "npm run theme:dev" },
];

const options = themes.map(theme => ({
  ...theme,
  installCommand: `npm run theme:install -- ${theme.id}`,
  enableCommand: `npm run theme:enable -- ${theme.id}`,
}));
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-12 pb-10">
      <h1 class="text-3xl font-semibold tracking-tight">Theme showcase</h1>
      <p class="mt-3 max-w-3xl text-base text-muted">
        Each of these Astro templates ships a very different editorial tone. Install one, enable it,
        then drop into <code class="font-mono">npm run theme:dev</code> to see how it feels—no
        rebuilds, just one repo running the enabled project.
      </p>
    </section>

    <section class="grid gap-6 sm:grid-cols-2">
      {options.map(theme => (
        <article class="rounded-3xl border border-border bg-background/70 p-6 shadow-2xl shadow-black/40">
          <h2 class="text-2xl font-semibold">{theme.name}</h2>
          <p class="mt-2 text-sm text-muted">{theme.description}</p>
          <p class="mt-4 text-xs uppercase tracking-[0.4em] text-muted">
            Demo: <a class="underline" href={theme.demo} target="_blank" rel="noreferrer">{theme.demo}</a>
          </p>
          <p class="mt-1 text-xs uppercase tracking-[0.4em] text-muted">Repo: {theme.repo}</p>
          <div class="mt-6 flex flex-wrap gap-2 text-xs font-mono text-muted">
            <span class="rounded-full border border-border px-3 py-1">{theme.installCommand}</span>
            <span class="rounded-full border border-border px-3 py-1">{theme.enableCommand}</span>
          </div>
        </article>
      ))}
    </section>

    <section class="mt-12 rounded-3xl border border-border bg-surface/80 p-6">
      <h3 class="text-xl font-semibold">Workflow commands</h3>
      <p class="mt-2 text-sm text-muted">
        Use the commands below to manage the enabled template, and set <code class="font-mono">THEME_PORT</code>
        before running <code class="font-mono">docker compose up</code> if you need another port for side-by-side comparisons.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {workflow.map(step => (
          <div class="rounded-2xl border border-border bg-background/70 px-4 py-3 text-sm text-muted">
            <p class="text-xs uppercase tracking-[0.4em] text-muted">{step.label}</p>
            <p class="font-mono text-sm text-foreground">{step.command}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
